LOCAL_POSTGRES_DB=orchestrator
LOCAL_POSTGRES_USER=orchestrator
LOCAL_POSTGRES_PASSWORD=orchestrator_password
DATABASE_URL=postgresql://orchestrator:orchestrator_password@postgres:5432/orchestrator
BT_WALLET_NAME=coldkey
BT_COLDKEY_NAME=hotkey
CALLBACK_GCS_BUCKET=gcs_bucket_0
EPISTULA_HOTKEY_SEED_PATH=./scratch/hotkey.txt
EPISTULA_COLDKEY_SEED_PATH=./scratch/coldkey.txt

# SS58 service (Pinata + signing)
SS58_BASE_URL=http://ss58:8585
SS58_TIMEOUT_SECONDS=5
SS58_PINATA_API_BASE=https://api.pinata.cloud
SS58_PINATA_GATEWAY_BASE=https://gateway.pinata.cloud/ipfs
SS58_PINATA_GATEWAY_TOKEN=<pinata-gateway-token>
SS58_PINATA_TIMEOUT_SECONDS=20
SS58_PINATA_JWT=<pinata-jwt>
SS58_PINATA_API_KEY=<pinata-api-key>
SS58_PINATA_API_SECRET=<pinata-api-secret>
SS58_HEAD_PATH=/var/lib/ss58/head.json
SS58_ED25519_SEED_HEX=<32-byte-hex-seed>
